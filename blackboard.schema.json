{
  "$id": "at1-blackboard",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AT1 黑板结构契约 v3（board.py 的活契约——字段/类型/枚举的机器真相；语义见 docs/at1-黑板schema.md）",
  "type": "object",
  "required": ["graph", "bookkeeping"],
  "properties": {
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      },
      "additionalProperties": false
    },
    "bookkeeping": {
      "type": "object",
      "required": ["offsets", "goal", "handoff", "config", "intel"],
      "properties": {
        "offsets": {"type": "object", "additionalProperties": true},
        "goal": {
          "type": "object",
          "required": ["text", "updated_round"],
          "properties": {
            "text": {"type": "string"},
            "updated_round": {"type": "integer"}
          },
          "additionalProperties": false
        },
        "handoff": {"type": "string"},
        "config": {"type": "object", "additionalProperties": true},
        "intel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "text"],
            "properties": {
              "round": {"type": "integer"},
              "text": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/intentNode"},
        {"$ref": "#/$defs/findingNode"},
        {"$ref": "#/$defs/factNode"}
      ]
    },
    "intentNode": {
      "type": "object",
      "required": ["id", "kind", "state", "payload", "endpoint", "origin", "round", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^D-[A-Za-z0-9\\-]+$"},
        "kind": {"enum": ["intent"]},
        "state": {"enum": ["open", "in_progress", "done", "blocked"]},
        "payload": {"$ref": "#/$defs/intentPayload"},
        "endpoint": {"type": "string"},
        "origin": {"enum": ["worker", "controller", "observer", "user"]},
        "round": {"type": "integer"},
        "updated_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "findingNode": {
      "type": "object",
      "required": ["id", "kind", "state", "payload", "endpoint", "origin", "round", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[A-Za-z0-9\\-]+$"},
        "kind": {"enum": ["finding"]},
        "state": {"enum": ["proposed", "confirmed", "dismissed"]},
        "payload": {"$ref": "#/$defs/findingPayload"},
        "endpoint": {"type": "string"},
        "origin": {"enum": ["worker", "controller", "observer", "user"]},
        "round": {"type": "integer"},
        "updated_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "factNode": {
      "type": "object",
      "required": ["id", "kind", "state", "payload", "endpoint", "origin", "round", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[A-Za-z0-9\\-]+$"},
        "kind": {"enum": ["fact"]},
        "state": {"enum": ["proposed", "confirmed", "dismissed", "superseded"]},
        "payload": {"$ref": "#/$defs/factPayload"},
        "endpoint": {"type": "string"},
        "origin": {"enum": ["worker", "controller", "observer", "user"]},
        "round": {"type": "integer"},
        "updated_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "intentPayload": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "comment": {"type": "string"},
        "blocked_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "findingPayload": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "report": {"type": "string"},
        "evidence": {"type": "string"},
        "severity": {"enum": ["high", "medium", "low", "none"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "factPayload": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "evidence": {"type": "string"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["src", "rel", "dst", "origin", "round"],
      "properties": {
        "src": {"type": "string", "pattern": "^[DFT]-[A-Za-z0-9\\-]+$"},
        "rel": {"enum": ["sources", "yields", "derived_from", "spawns", "same_root", "supersedes"]},
        "dst": {"type": "string", "pattern": "^[DFT]-[A-Za-z0-9\\-]+$"},
        "origin": {"enum": ["worker", "observer", "controller"]},
        "note": {"type": "string"},
        "round": {"type": "integer"}
      },
      "additionalProperties": false
    }
  }
}
